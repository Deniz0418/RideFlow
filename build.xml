<?xml version="1.0" encoding="UTF-8"?>
<project name="RideFlow" default="run" basedir=".">
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="dist.dir" value="dist"/>

    <target name="init">
        <mkdir dir="${classes.dir}"/>
    </target>

    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${classes.dir}" release="21"
               includeantruntime="false" encoding="UTF-8" debug="true"/>
    </target>

    <target name="run" depends="compile">
        <java classname="rideflow.app.Main" fork="true" failonerror="true">
            <classpath><pathelement location="${classes.dir}"/></classpath>
        </java>
    </target>

    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.dir}/RideFlow.jar" basedir="${classes.dir}">
            <manifest><attribute name="Main-Class" value="rideflow.app.Main"/></manifest>
        </jar>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
</project>
